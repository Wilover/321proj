{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "M5: Debug a manual milestone",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/manual_m5.py",
      "python": "/usr/bin/python3",
      "args": ["${input:milestone}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "subProcess": false,
      "justMyCode": true
    }
  ],
  "inputs": [
    {"id": "milestone", "type": "pickString", "description": "M5 manual test milestone", "options": ["week1", "week2", "week3", "week4", "kernel"], "default": "week1"}
  ]
}
